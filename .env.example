# ==================================================
# LANDING PAGE GENERATOR - CONFIGURATION
# ==================================================

# --------------------------------------------------
# BASE DE DONNÉES
# --------------------------------------------------
# Connection Azure SQL Server
# Format: sqlserver://HOST:PORT;database=DATABASE;user=USER;password=PASSWORD;encrypt=true;trustServerCertificate=false

# Azure SQL Database (Recommandé pour production)
DATABASE_URL="sqlserver://your-server.database.windows.net:1433;database=landing-generator;user=your-username;password=your-password;encrypt=true;trustServerCertificate=false"

# Alternative: Local SQL Server (Développement)
# DATABASE_URL="sqlserver://localhost:1433;database=landing_generator;user=sa;password=YourPassword123;encrypt=true;trustServerCertificate=true"

# Alternative: SQLite (Développement local seulement)
# DATABASE_URL="file:./dev.db"

# --------------------------------------------------
# OPENAI API
# --------------------------------------------------
# Obtenez votre clé API sur: https://platform.openai.com/api-keys
# Assurez-vous d'avoir des crédits disponibles
OPENAI_API_KEY="sk-proj-..."

# --------------------------------------------------
# GOOGLE GEMINI API
# --------------------------------------------------
# Obtenez votre clé API sur: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSy..."

# --------------------------------------------------
# APPLICATION
# --------------------------------------------------
# URL de base de votre application
# Développement:
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Production (exemple):
# NEXT_PUBLIC_APP_URL="https://mon-site.com"

# --------------------------------------------------
# OPTIONNEL
# --------------------------------------------------
# Mode de développement (affiche plus de logs)
# NODE_ENV="development"

# Prisma logs (débogage)
# DEBUG="prisma:*"

# --------------------------------------------------
# CLOUDINARY (Stockage d'images)
# --------------------------------------------------
# Obtenez vos identifiants sur: https://cloudinary.com/users/login
# Gratuit jusqu'à 25 GB de stockage et 25 GB de bande passante
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
