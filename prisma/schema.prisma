// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_UNPOOLED")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  
  // Informations produit détaillées
  headline    String?
  currency    String   @default("DA")
  priceOld    Float?
  priceNew    Float?
  
  // CTA & Contact
  ctaText     String   @default("Commander maintenant")
  phone       String?
  whatsapp    String?
  deliveryInfo String?
  
  // Bénéfices (JSON)
  benefits    Json?
  
  // Ad Copies (JSON array, 1-5 optionnelles)
  adCopies    Json?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images       ProductImage[]
  landingPages LandingPage[]
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model LandingPage {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  // Informations produit
  headline    String
  description String?
  price       Float
  oldPrice    Float?
  currency    String   @default("EUR")
  
  // CTA & Contact
  ctaText     String   @default("Acheter maintenant")
  phone       String?
  whatsapp    String?
  
  // Palette de couleurs
  primaryColor    String
  secondaryColor  String
  accentColor     String
  backgroundColor String
  
  // Status
  status      String   @default("draft") // draft, published
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  benefits    Benefit[]
  sections    Section[]
}

model Benefit {
  id             String      @id @default(cuid())
  title          String
  description    String
  icon           String?
  order          Int         @default(0)
  landingPageId  String
  landingPage    LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())
}

model Section {
  id             String      @id @default(cuid())
  type           String      // hero, problem, solution, before-after, benefits, how-it-works, social-proof, cta
  title          String?
  content        String?     @db.Text
  images         String[]
  prompt         String?     @db.Text
  order          Int         @default(0)
  isActive       Boolean     @default(true)
  generationStatus String    @default("pending") // pending, generating, completed, error
  landingPageId  String
  landingPage    LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}
