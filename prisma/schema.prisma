// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  headline    String?
  description String?  @db.Text
  
  // Pricing & CTA
  currency    String   @default("DA")
  priceOld    Float?
  priceNew    Float?
  ctaText     String   @default("Commander maintenant")
  
  // Contact & Livraison
  phone        String?
  whatsapp     String?
  deliveryInfo String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images   ProductImage[]
  personas Persona[]
}

model Persona {
  id          String   @id @default(cuid())
  name        String   // Ex: "Maman occupée", "Étudiant fauché"
  description String?  @db.Text  // Description détaillée du persona, douleurs, désirs
  
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  marketingAngles MarketingAngle[]
  landingPages    LandingPage[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MarketingAngle {
  id          String   @id @default(cuid())
  name        String   // Ex: "Gain de temps", "Économie d'argent"
  description String?  @db.Text  // Explication de l'angle
  
  personaId   String
  persona     Persona  @relation(fields: [personaId], references: [id], onDelete: Cascade)
  
  adCopies    AdCopy[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdCopy {
  id               String   @id @default(cuid())
  text             String   @db.Text  // Corps du texte avec emojis et structuré
  cta              String?  // Appel à l'action spécifique
  platform         String?  // Ex: "Facebook", "TikTok", "Email"
  
  marketingAngleId String
  marketingAngle   MarketingAngle @relation(fields: [marketingAngleId], references: [id], onDelete: Cascade)
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String   @db.Text
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model LandingPage {
  id        String   @id @default(cuid())
  
  // Relation unique vers Persona (qui est lié au Product)
  personaId String
  persona   Persona  @relation(fields: [personaId], references: [id], onDelete: Cascade)
  
  // Status
  status String @default("draft") // draft, published
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  benefits Benefit[]
  sections Section[]
}

model Benefit {
  id             String      @id @default(cuid())
  title          String
  description    String      @db.Text
  icon           String?
  order          Int         @default(0)
  landingPageId  String
  landingPage    LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())
}

model AIConfiguration {
  id          String   @id @default(cuid())
  endpoint    String   @unique // 'benefits', 'headline', 'images', 'palette', etc.
  modelName   String   // 'gemini-3-flash-preview', 'gemini-2.5-flash', etc.
  description String?  // Description de l'endpoint
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AIRequestLog {
  id            String   @id @default(cuid())
  endpoint      String   // 'benefits', 'headline', etc.
  modelUsed     String   // Modèle AI utilisé
  inputData     String   @db.Text  // JSON des données d'entrée
  prompt        String?  @db.Text  // Le prompt envoyé à l'AI
  response      String?  @db.Text  // La réponse de l'AI
  status        String   // 'success', 'error'
  errorMessage  String?  // Message d'erreur si échec
  duration      Int?     // Durée en ms
  createdAt     DateTime @default(now())
}

model Section {
  id             String      @id @default(cuid())
  type           String      // hero, problem, solution, before-after, benefits, how-it-works, social-proof, cta
  images         String      @db.Text  // JSON array d'images en string
  prompt         String?     @db.Text  // Prompt utilisé pour générer la section
  order          Int         @default(0)
  isActive       Boolean     @default(true)
  generationStatus String    @default("pending") // pending, generating, completed, error
  landingPageId  String
  landingPage    LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}
