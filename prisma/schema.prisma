// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  
  // Informations produit détaillées
  headline    String?
  currency    String   @default("DA")
  priceOld    Float?
  priceNew    Float?
  
  // CTA & Contact
  ctaText     String   @default("Commander maintenant")
  phone       String?
  whatsapp    String?
  deliveryInfo String?
  
  // Bénéfices (JSON)
  benefits    Json?
  
  // ANCIEN: Ad Copies (JSON array) - Remplacé par la structure Persona -> MarketingAngle -> AdCopy
  // adCopies    Json?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images       ProductImage[]
  personas     Persona[]
  landingPages LandingPage[] // Gardé pour rétrocompatibilité, mais idéalement on passe par les personas
}

model Persona {
  id          String   @id @default(cuid())
  name        String   // Ex: "Maman occupée", "Étudiant fauché"
  description String?  // Description détaillée du persona, douleurs, désirs
  
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  marketingAngles MarketingAngle[]
  landingPages    LandingPage[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MarketingAngle {
  id          String   @id @default(cuid())
  name        String   // Ex: "Gain de temps", "Économie d'argent"
  description String?  // Explication de l'angle
  
  personaId   String
  persona     Persona  @relation(fields: [personaId], references: [id], onDelete: Cascade)
  
  adCopies    AdCopy[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdCopy {
  id               String   @id @default(cuid())
  text             String   // Corps du texte avec emojis et structuré
  cta              String?  // Appel à l'action spécifique
  platform         String?  // Ex: "Facebook", "TikTok", "Email"
  
  marketingAngleId String
  marketingAngle   MarketingAngle @relation(fields: [marketingAngleId], references: [id], onDelete: Cascade)
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model LandingPage {
  id          String   @id @default(cuid())
  
  // Relations
  productId   String?  // Rendu optionnel pour transition vers Persona
  product     Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  personaId   String?  // Nouvelle relation vers Persona
  persona     Persona? @relation(fields: [personaId], references: [id], onDelete: Cascade)
  
  // Informations produit
  headline    String
  description String?
  price       Float
  oldPrice    Float?
  currency    String   @default("EUR")
  
  // CTA & Contact
  ctaText     String   @default("Acheter maintenant")
  phone       String?
  whatsapp    String?
  
  // Palette de couleurs
  primaryColor    String
  secondaryColor  String
  accentColor     String
  backgroundColor String
  
  // Status
  status      String   @default("draft") // draft, published
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  benefits    Benefit[]
  sections    Section[]
}

model Benefit {
  id             String      @id @default(cuid())
  title          String
  description    String
  icon           String?
  order          Int         @default(0)
  landingPageId  String
  landingPage    LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())
}

model Section {
  id             String      @id @default(cuid())
  type           String      // hero, problem, solution, before-after, benefits, how-it-works, social-proof, cta
  title          String?
  content        String?     // Text sans @db.Text pour SQLite
  images         String      // JSON array d'images en string
  prompt         String?     // Text sans @db.Text pour SQLite
  order          Int         @default(0)
  isActive       Boolean     @default(true)
  generationStatus String    @default("pending") // pending, generating, completed, error
  landingPageId  String
  landingPage    LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}
